{
  "name": "lightcode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --watch --env-file=apps/server/.env run apps/server/src/index.ts",
    "dev:cli": "bun run apps/cli/src/index.tsx",
    "build": "bun --filter '*' build",
    "db:generate": "bun --filter server db:generate",
    "db:push": "bun --filter server db:push",
    "db:studio": "bun --filter server db:studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "cli": "workspace:*",
    "typescript": "^5.6.0"
  }
}
